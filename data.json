    "VERIFIED": {
        "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Oz Yosef Yohay</title>\n<script src=\"https://cdn.jsdelivr.net/npm/marked/marked.min.js\"></script>\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css\">\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js\"></script>\n<style>\n    :root {\n        --bg-main: #fcfcfc;\n        --bg-content: #fcfcfc;\n        --bg-code: #f0f0f0;\n        --text-main: #1b1b1b;\n        --text-secondary: #555555;\n        --text-active: #aa3939;\n        --border-color: #e0e0e0;\n    }\n\n    body {\n        margin: 0;\n        font-family: monospace;\n        background-color: var(--bg-main);\n        color: var(--text-main);\n        display: flex;\n        flex-direction: column;\n        height: 100vh;\n        overflow: hidden;\n    }\n    .header {\n        display: flex;\n        gap: 20px;\n        padding: 10px 15px;\n        background-color: none;\n        border-bottom: none;\n        overflow-x: auto;\n        white-space: nowrap;\n        scrollbar-width: none;\n        font-family: 'Courier New', monospace;\n    }\n    .header::-webkit-scrollbar {\n        display: none;\n    }\n    .header button {\n        background: none;\n        border: none;\n        font-family: inherit;\n        font-size: 16px;\n        color: var(--text-secondary);\n        cursor: pointer;\n        padding: 0;\n    }\n    .header button.active {\n        color: var(--text-active);\n    }\n    .main-area {\n        display: flex;\n        flex: 1;\n        overflow: hidden;\n    }\n    .sidebar {\n        width: 150px;\n        background-color: transparent;\n        border-right: none;\n        display: flex;\n        flex-direction: column;\n        padding: 15px 20px;\n        gap: 10px;\n        overflow-y: auto;\n        font-family: 'Courier New', monospace;\n    }\n    .sidebar button {\n        background: none;\n        border: none;\n        font-family: inherit;\n        font-size: 14px;\n        color: var(--text-secondary);\n        cursor: pointer;\n        text-align: left;\n        padding: 0;\n    }\n    .sidebar button.active {\n        color: var(--text-active);\n    }\n    .content-area {\n        flex: 1;\n        padding: 40px;\n        overflow-y: auto;\n        background-color: var(--bg-content);\n    }\n    img {\n        max-width: 100%;\n        height: auto;\n    }\n    pre {\n        background-color: var(--bg-code);\n        padding: 15px;\n        overflow-x: auto;\n    }\n    \n    @media (max-width: 768px) {\n        .main-area {\n            flex-direction: column;\n        }\n        .sidebar {\n            width: 100%;\n            flex-direction: row;\n            border-right: none;\n            border-bottom: 1px solid var(--border-color);\n            overflow-x: auto;\n            white-space: nowrap;\n            padding: 10px 20px;\n            box-sizing: border-box;\n            scrollbar-width: none;\n        }\n        .sidebar::-webkit-scrollbar {\n            display: none;\n        }\n        .content-area {\n            padding: 20px;\n        }\n    }\n</style>\n</head>\n<body>\n\n<div class=\"header\" id=\"headerNav\"></div>\n<div class=\"main-area\">\n    <div class=\"sidebar\" id=\"sidebarNav\"></div>\n    <div class=\"content-area\" id=\"contentView\"></div>\n</div>\n\n<script>\n    const portfolioData = {\n        \"Oz Yosef Yohay\": {\n            \"README.md\": \"![Logo](https://picsum.photos/800/200?grayscale)\\n\\n# oz yosef yohay\\n\\nsystems engineer and software developer\\n\\n## contact\\n\\nemail: demo@example.com\\n\\nlocation: israel\"\n        },\n        \"VERIFIED*\": {\n            \"README.md\": \"![Verified](https://picsum.photos/800/200?grayscale&random=1)\\n\\n# formal verification projects\\n\\nthis section contains proofs and mathematically verified software models\",\n            \"proof.dfy\": \"method Abs(x: int) returns (y: int)\\n  ensures 0 <= y\\n  ensures 0 <= x ==> y == x\\n  ensures x < 0 ==> y == -x\\n{\\n  if x < 0 {\\n    return -x;\\n  } else {\\n    return x;\\n  }\\n}\"\n        },\n        \"C++\": {\n            \"README.md\": \"![Cpp](https://picsum.photos/800/200?grayscale&random=2)\\n\\n# c plus plus systems\\n\\nrugged architecture and memory management examples\",\n            \"main.cpp\": \"#include <iostream>\\n\\nint main() {\\n    std::cout << \\\"system initialized\\\" << std::endl;\\n    return 0;\\n}\"\n        },\n        \"PHARMGURD\": {\n            \"README.md\": \"![Pharm](https://picsum.photos/800/200?grayscale&random=3)\\n\\n# pharmgurd nfc project\\n\\nsmart medication tracking system documentation\",\n            \"architecture.txt\": \"utilizing nfc tags for supply chain verification and dosage adherence\"\n        },\n        \"HOMEWORK\": {\n            \"README.md\": \"![Homework](https://picsum.photos/800/200?grayscale&random=4)\\n\\n# academic assignments\\n\\nselected algorithms and data structures\",\n            \"math.txt\": \"teaching materials for advanced student groups\"\n        }\n    };\n\n    let currentCategory = \"Oz Yosef Yohay\";\n    let currentFile = \"README.md\";\n\n    // initializes the application and renders the first active view\n    function initApp() {\n        renderHeader();\n        selectCategory(currentCategory);\n    }\n\n    // builds the top navigation bar using category names\n    function renderHeader() {\n        const header = document.getElementById('headerNav');\n        header.innerHTML = '';\n        \n        const categories = Object.keys(portfolioData);\n        categories.forEach(cat => {\n            const btn = document.createElement('button');\n            btn.textContent = cat;\n            if (cat === currentCategory) {\n                btn.className = 'active';\n            }\n            btn.onclick = function() {\n                selectCategory(cat);\n            };\n            header.appendChild(btn);\n        });\n    }\n\n    // handles category selection and updates the user interface state\n    function selectCategory(category) {\n        currentCategory = category;\n        renderHeader();\n        \n        const files = Object.keys(portfolioData[category]);\n        if (files.length === 0) {\n            currentFile = null;\n        } else if (files.includes('README.md')) {\n            currentFile = 'README.md';\n        } else {\n            currentFile = files[0];\n        }\n        \n        renderSidebar();\n        renderContent();\n    }\n\n    // builds the file list sidebar for the currently active category\n    function renderSidebar() {\n        const sidebar = document.getElementById('sidebarNav');\n        sidebar.innerHTML = '';\n        \n        const files = Object.keys(portfolioData[currentCategory]);\n        files.forEach(file => {\n            const btn = document.createElement('button');\n            btn.textContent = file;\n            if (file === currentFile) {\n                btn.className = 'active';\n            }\n            btn.onclick = function() {\n                selectFile(file);\n            };\n            sidebar.appendChild(btn);\n        });\n    }\n\n    // updates the active file state and triggers the main display\n    function selectFile(file) {\n        currentFile = file;\n        renderSidebar();\n        renderContent();\n    }\n\n    // parses markdown or code and injects it into the viewing container safely\n    function renderContent() {\n        const view = document.getElementById('contentView');\n        if (!currentFile) {\n            view.innerHTML = '';\n            return;\n        }\n        \n        const content = portfolioData[currentCategory][currentFile];\n        \n        if (currentFile.endsWith('.md')) {\n            view.innerHTML = marked.parse(content);\n        } else if (currentFile.endsWith('.txt')) {\n            view.innerHTML = '<pre>' + content + '</pre>';\n        } else {\n            const extension = currentFile.split('.').pop();\n            const formatted = '<pre><code class=\"language-' + extension + '\">' + content + '</code></pre>';\n            view.innerHTML = formatted;\n        }\n        \n        if (typeof hljs !== 'undefined') {\n            hljs.highlightAll();\n        }\n    }\n\n    initApp();\n</script>\n</body>\n</html>"
    }
